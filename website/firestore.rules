rules_version = '2';

// The only data is the public download counter at stats/downloads.
// Anyone may read it; a write may only add exactly one and may not add fields.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stats/downloads {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
